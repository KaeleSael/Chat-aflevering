doctype html
html
    head
        title Brugerforside
        link(rel="stylesheet" href="/css/style.css")

    body
        main.SideContainer
            header.SideHeader
                    span
                    h1 Chat oversigt

                    div.SideHeaderActions
                        form(action="/logout" method="POST")
                            button.redButton(type="submit") Log ud

            hr.SideDivider

            div.ChatFunktioner
                a.sideButton(href="/chats/opret") Ny chat
                a.sideButton(href="/beskeder") Se mine beskeder

                if brugerNiveau === 3
                    a.sideButton(href="/brugere") Administrer brugere

            section.ChatOversigtIndhold
                h2 Dine chats:

                div.ChatListe
                    if chats && chats.length > 0
                        each chat in chats
                            a.chatButton(href="/chats/" + chat.id)= chat.navn
                    else
                        p Du har endnu ikke skrevet nogen chats.