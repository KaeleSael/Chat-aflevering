
doctype html
html
    head
        title Brugerforside
        link(rel="stylesheet" href="/css/style.css")

    body
        main.BrugerSide
            h1 Chat Oversigt

            section.Chat
                h2 Dine chats:

                div.FunktionListe
                    form(action="/logout" method="POST")
                        button.sideButton(type="nychat") Ny Chat

                    a.sideButton(href="/beskeder") Se alle dine beskeder

                    if brugerNiveau === 3
                        a.sideButton(href="/brugere") Administrer brugere

                    form(action="/logout" method="POST")
                        button.sideButton(type="submit") Log ud

                h2 Dine chats:

                div.ChatListe
                    if chats && chats.length > 0
                        each chat in chats
                            a.chatButton(href="/chats/" + chat.id)= chat.navn
                    else
                        p Du har endnu ikke skrevet nogen chats.