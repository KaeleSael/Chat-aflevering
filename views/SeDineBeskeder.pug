doctype html
html
    head
        title Mine beskeder
        link(rel="stylesheet" href="/css/style.css")

    body
        main.SideContainer
            header.SideHeader
                    a.sideButton(href="/chats") Tilbage til forsiden
                    h1 Mine beskeder
                    div.SideHeaderActions
                        form(action="/logout" method="POST")
                            button.redButton(type="submit") Log ud

            hr.SideDivider

            section.MineBeskederListe
                if beskeder && beskeder.length > 0
                    each besked in beskeder
                        div.MineBeskedKort
                            div.MineBeskedHeader
                                h2= besked.chatNavn
                                small= new Date(besked.oprettelsesDato).toLocaleString('da-DK')

                            p= besked.krypteretIndhold

                            small.BeskedAfsender
                                | Skrevet af: #{besked.ejerNavn}
                else
                    div.IngenChats
                        h2 Ingen beskeder endnu
                        p Du har endnu ikke skrevet nogen beskeder.