doctype html
html
    head
        title Mine beskeder
        link(rel="stylesheet" href="/css/style.css")

    body
        main.SideContainer
            header.SideHeader
                    a.sideButton(href="/forside") Tilbage til forsiden
                    h1 Mine beskeder

            hr.SideDivider

            section.MineBeskederListe
                if beskeder && beskeder.length > 0
                    each besked in beskeder
                        div.MineBeskedKort
                            div.MineBeskedHeader
                                h2= besked.chatNavn
                                small= besked.dato

                            p= besked.tekst

                            small.BeskedAfsender
                                | Skrevet af: #{besked.ejerNavn}
                else
                    div.IngenChats
                        h2 Ingen beskeder endnu
                        p Du har endnu ikke skrevet nogen beskeder.