doctype html
html
    head
        title Opret bruger
        link(rel="stylesheet" href="/css/style.css")
    body
        main.login-page
            section.login-card
                h1 Opret bruger
                h2 Opret en ny konto

                form(action="/opretBruger" method="POST")
                    input(
                        type="text"
                        name="username"
                        placeholder="Brugernavn"
                        required
                    )

                    input(
                        type="password"
                        name="password"
                        placeholder="Adgangskode"
                        required
                    )

                    input(
                        type="password"
                        name="gentagPassword"
                        placeholder="Gentag adgangskode"
                        required
                    )

                    button(type="submit") Opret bruger

                a(href="/") Tilbage til login