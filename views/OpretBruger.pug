doctype html
html
    head
        title Opret bruger
        link(rel="stylesheet" href="/css/style.css")

    body
        main.SideContainer
            header.SideHeader
                    a.sideButton(href="/") Tilbage til login
                    h1 Opret bruger

            hr.SideDivider

            section.OpretBrugerIndhold
                h2 Opret en ny konto

                form.OpretBrugerForm(action="/opretBruger" method="POST")
                    label(for="username") Brugernavn
                    input#username(
                        type="text"
                        name="username"
                        placeholder="Brugernavn"
                        required
                    )

                    label(for="password") Adgangskode
                    input#password(
                        type="password"
                        name="password"
                        placeholder="Adgangskode"
                        required
                    )

                    label(for="gentagPassword") Gentag adgangskode
                    input#gentagPassword(
                        type="password"
                        name="gentagPassword"
                        placeholder="Gentag adgangskode"
                        required
                    )

                    button.sideButton(type="submit") Opret bruger