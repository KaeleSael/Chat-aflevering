doctype html
html
    head
        title Administrer brugere
        link(rel="stylesheet" href="/css/style.css")

    body
        main.SideContainer
            header.SideHeader
                    a.sideButton(href="/chats") Tilbage til forsiden
                    h1 Administrer brugere
                    div.SideHeaderActions
                        form(action="/logout" method="POST")
                            button.redButton(type="submit") Log ud                    

            hr.SideDivider

            section.BrugerListe
                if brugere && brugere.length > 0
                    each bruger in brugere
                        div.Bruger
                            h2= bruger.username
                            p Bruger-ID: #{bruger.id}
                            p Adgangsniveau: #{bruger.niveau}

                            form(action="/users/" + bruger.id + "/niveau" method="POST")
                                label(for="niveau-" + bruger.id) Ændr adgangsniveau:

                                select(name="niveau" id="niveau-" + bruger.id)
                                    option(value="1" selected=bruger.niveau === 1) Niveau 1
                                    option(value="2" selected=bruger.niveau === 2) Niveau 2
                                    option(value="3" selected=bruger.niveau === 3) Niveau 3

                                button.sideButton(type="submit") Gem ændringer
                else
                    p Der er ingen brugere at vise.
